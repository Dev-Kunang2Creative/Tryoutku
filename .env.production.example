# Contoh berkas lingkungan untuk server produksi.
#
# Salin menjadi .env DI SERVER, lalu isi nilainya. Berkas .env tidak pernah
# ikut dikirim oleh proses deploy, jadi isinya aman tinggal di server dan
# tidak akan tertimpa saat ada pembaruan.

APP_NAME=Tryoutku
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ujian.kikz.tech

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Dibuat lewat hPanel: Databases -> Management. Hostinger memberi awalan
# tetap pada nama basis data dan nama pengguna, jadi salin persis apa adanya.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Aplikasi ini tidak pernah mengirim surel; log menjaga agar kegagalan
# pengiriman tidak pernah menjadi masalah.
MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
